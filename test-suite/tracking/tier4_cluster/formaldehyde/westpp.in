# Decomposition of states 1-4. nspin = 1: only "C" (the multiplicity "M" needs
# nspin = 2), and no westpp_l_spin_flip (used only when nspin = 2).
input_west:
  outdir: ./
westpp_control:
  westpp_calculation: C
  westpp_range:
  - 1
  - 4
  westpp_n_liouville_to_use: 4
  westpp_format: C
  westpp_sign: true
