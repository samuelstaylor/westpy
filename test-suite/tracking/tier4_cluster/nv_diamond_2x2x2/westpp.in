# Decomposition (C) + spin multiplicity (M, nspin = 2) of states 1-4.
# Spin-conserving TDDFT: westpp_l_spin_flip false (= wbse_control.l_spin_flip default).
input_west:
  outdir: ./
westpp_control:
  westpp_calculation: CM
  westpp_range:
  - 1
  - 4
  westpp_n_liouville_to_use: 4
  westpp_format: C
  westpp_sign: true
  westpp_l_spin_flip: false
