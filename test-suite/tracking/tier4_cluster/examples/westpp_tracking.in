# westpp input for tracking: decomposition (C) + spin multiplicity (M) of the
# states that may be tracked. westpp_range must cover forces_state and stay
# within n_liouville_eigen of wbse.in. westpp_sign: true gives signed X_vc.
# westpp_l_spin_flip must match wbse_control.l_spin_flip (nspin = 2).
# Note: the valid key is westpp_l_compute_tdm (there is no westpp_l_compute).
input_west:
  qe_prefix: pwscf
  west_prefix: west
  outdir: ./
westpp_control:
  westpp_calculation: CM
  westpp_range:
  - 1
  - 4
  westpp_n_liouville_to_use: 4
  westpp_format: C
  westpp_sign: true
  westpp_l_spin_flip: false
  westpp_l_compute_tdm: false
